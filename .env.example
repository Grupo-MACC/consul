# =============================================================================
# EC2-CONSUL + ADS CAPTURE - Variables de Entorno
# =============================================================================
# Copia este archivo a .env y ajusta los valores

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
LOG_LEVEL=INFO

# ============================================
# CONSUL
# ============================================
# Ruta a los certificados TLS
CERTS_PATH=/path/to/certs

# ============================================
# ZEEK - Captura de tráfico
# ============================================
# Interfaz de red para capturar tráfico
# - EC2 Nitro (t3, m5, c5, r5, etc.): ens5
# - EC2 antiguas: eth0
# - Local con Docker nativo Linux: docker0 o br-xxx
# - Local con Docker Desktop (Windows/Mac): NO FUNCIONA con network_mode: host
#   -> Usar: docker compose -f docker-compose.yaml -f docker-compose.local.yaml up
#
# Para descubrir interfaces: ip link show | grep -E "^[0-9]"
CAPTURE_INTERFACE=ens5

# ============================================
# CONSUL - Service Discovery (HTTPS)
# ============================================
# IP de la máquina EC2-Consul (esta máquina)
# Se usa para filtrar tráfico y para desregistro de servicios
CONSUL_HOST=10.1.11.40
CONSUL_PORT=8501

# ============================================
# MERGER - Procesamiento de ventanas
# ============================================
# Intervalo de procesamiento (segundos)
PROCESS_INTERVAL=5

# URL del ADS Server (EC2-ADS)
ADS_SERVER_URL=http://10.1.12.10:8080/predict
